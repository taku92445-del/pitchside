rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memPath(cid) { return /databases/$(database)/documents/clubs/$(cid)/members/$(request.auth.uid); }
    function isMember(cid) { return signedIn() && exists(memPath(cid)); }
    function role(cid) { return get(memPath(cid)).data.role; }
    function isStaffOf(cid) { return isMember(cid) && role(cid) in ['admin', 'staff']; }
    function myPid(cid) { return get(memPath(cid)).data.personId; }
    function permPath(cid) { return /databases/$(database)/documents/clubs/$(cid)/perm/$(myPid(cid)); }
    function canMed(cid) { return role(cid) == 'admin' || (exists(permPath(cid)) && get(permPath(cid)).data.v.med == true); }
    function clubDoc(cid, sub, id) { return /databases/$(database)/documents/clubs/$(cid)/$(sub)/$(id); }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /invites/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isStaffOf(request.resource.data.cid);
      allow delete: if isStaffOf(resource.data.cid);
    }

    // 紹介ページの先行利用申し込み：だれでも送れるが、読めるのはFirebaseの管理画面だけ
    match /signups/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['club', 'name', 'email', 'size', 'tool', 'pain', 'ts', 'src'])
        && request.resource.data.club is string && request.resource.data.club.size() > 0 && request.resource.data.club.size() <= 80
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && request.resource.data.email.size() <= 120
        && request.resource.data.size is string && request.resource.data.size.size() <= 20
        && request.resource.data.tool is string && request.resource.data.tool.size() <= 40
        && request.resource.data.pain is string && request.resource.data.pain.size() <= 600
        && request.resource.data.src is string && request.resource.data.src.size() <= 40
        && request.resource.data.ts == request.time;
    }

    // 紹介ページの閲覧数：1回に1ずつ増やすことだけできる
    match /stats/{sid} {
      allow read: if false;
      allow create: if sid in ['lp', 'lp_click'] && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if sid in ['lp', 'lp_click'] && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }

    match /clubs/{cid} {
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow read: if isMember(cid);
      allow update: if isMember(cid) && role(cid) == 'admin';

      match /members/{uid} {
        allow read: if isMember(cid);
        allow create: if signedIn() && uid == request.auth.uid && (
          (request.resource.data.role == 'admin'
            && getAfter(/databases/$(database)/documents/clubs/$(cid)).data.owner == request.auth.uid)
          || (request.resource.data.role in ['player', 'staff']
            && exists(clubDoc(cid, 'joinkeys', request.resource.data.personId + '_' + request.resource.data.pin))
            && !exists(clubDoc(cid, 'claims', request.resource.data.personId))
            && getAfter(clubDoc(cid, 'claims', request.resource.data.personId)).data.uid == request.auth.uid)
          || (request.resource.data.role == 'guardian'
            && exists(clubDoc(cid, 'joinkeys', request.resource.data.personId + '_' + request.resource.data.pin))
            && !exists(clubDoc(cid, 'gclaims', request.resource.data.personId))
            && getAfter(clubDoc(cid, 'gclaims', request.resource.data.personId)).data.uid == request.auth.uid)
        );
        allow update: if false;
        allow delete: if isStaffOf(cid);
      }

      match /claims/{pid} {
        allow read: if isMember(cid);
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && getAfter(memPath(cid)).data.personId == pid
          && getAfter(memPath(cid)).data.role in ['admin', 'player', 'staff'];
        allow delete: if isStaffOf(cid);
      }

      match /gclaims/{pid} {
        allow read: if isMember(cid);
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && getAfter(memPath(cid)).data.personId == pid
          && getAfter(memPath(cid)).data.role == 'guardian';
        allow delete: if isStaffOf(cid);
      }

      match /joinkeys/{key} {
        allow read: if false;
        allow write: if isStaffOf(cid);
      }

      match /meta/{doc} {
        allow read, write: if isStaffOf(cid);
      }

      match /perm/{pid} {
        allow read: if isMember(cid);
        allow write: if isMember(cid) && role(cid) == 'admin';
      }

      match /staffonly/{doc} {
        allow read, write: if isStaffOf(cid);
      }

      // 個人の記録：s=本人とスタッフ / m=本人と医療情報を許可されたスタッフ / p=本人だけ / d=本人とスタッフの個別連絡
      match /pd/{id} {
        allow read: if isMember(cid) && (
          resource.data.pid == myPid(cid)
          || (resource.data.kind in ['s', 'd'] && isStaffOf(cid))
          || (resource.data.kind == 'm' && isStaffOf(cid) && canMed(cid)));
        allow create: if isMember(cid)
          && id == request.resource.data.pid + '_' + request.resource.data.kind
          && request.resource.data.kind in ['s', 'm', 'p', 'd']
          && (request.resource.data.pid == myPid(cid) || (isStaffOf(cid) && request.resource.data.kind != 'p'));
        allow update: if isMember(cid)
          && request.resource.data.pid == resource.data.pid
          && request.resource.data.kind == resource.data.kind
          && (resource.data.pid == myPid(cid) || (isStaffOf(cid) && resource.data.kind != 'p'));
        allow delete: if isStaffOf(cid);
      }

      match /tokens/{uid} {
        allow read, write: if isMember(cid) && request.auth.uid == uid;
      }

      match /state/{doc} {
        allow read, write: if isMember(cid);
      }
    }
  }
}
